{
  "name": "xodus-desktop",
  "version": "2.0.0",
  "description": "Turn downloaded Xbox Game Pass (xodus / MSIXVC / GDK) titles into native Linux .desktop entries and Steam shortcuts — no launcher fork required",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "xodus-desktop": "./bin/xodus-desktop.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "jest",
    "sync": "node ./bin/xodus-desktop.js sync",
    "doctor": "node ./bin/xodus-desktop.js doctor",
    "install-system": "./scripts/install.sh"
  },
  "keywords": [
    "xodus",
    "xbox-game-pass",
    "gdk",
    "msixvc",
    "proton",
    "wine",
    "steam-shortcuts",
    "desktop-entry",
    "linux-gaming"
  ],
  "author": "73chn1c",
  "license": "GPL-3.0",
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.5.0"
  }
}
